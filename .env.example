# Copy to `.env` and fill in. `.env` is gitignored and must stay that way —
# DATABASE_URL carries the database password.
#
# The same values go into Vercel's environment variables for deploys. Neither
# place is this repository, and neither is a chat window.

# Neon, from the dashboard's connection string. Use the pooled one for the app.
DATABASE_URL=

# Better Auth's signing secret. Any long random string, different per
# environment: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Where the site is served from. http://localhost:4321 in development.
PUBLIC_SITE_URL=https://tova.so
