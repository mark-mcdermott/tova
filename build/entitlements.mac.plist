<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      The hardened runtime blocks the JIT and the unsigned memory Chromium
      needs; without these two a notarized build launches to a blank window.
      Nothing else is requested: Tova reads and writes one folder in Documents
      and talks to GitHub, neither of which needs an entitlement.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
