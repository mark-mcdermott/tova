{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "paths": {
      "@renderer/*": [
        "./src/renderer/*"
      ]
    }
  },
  "include": [
    "src/renderer",
    "src/shared"
  ]
}
