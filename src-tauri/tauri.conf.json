{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tova",
  "version": "1.0.0",
  "identifier": "io.markmcdermott.tova",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm exec vite --config vite.renderer.config.ts",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "copyright": "\u00a9 Mark McDermott"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mark-mcdermott/tova/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEQzUzMTg3NUVGODBGMEUKUldRT0QvaGVoekhGTFVTeXl4ZHlGQjB2Q3ZZUUNxVmtmakNuc0I2eStBWVdDNlo2UHI3eGxMNnUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
