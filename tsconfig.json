{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "paths": {
      "@renderer/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "src/renderer",
    "src/shared",
    "src/server",
    "web",
    // Astro's generated types, which `astro sync` writes and `check` now runs
    // first. `astro:env/server` is a virtual module built from the schema in
    // `astro.config.mjs`, so without this the imports in `src/server/` read as
    // missing packages — and `.astro/` is generated and ignored, which is why
    // the sync has to happen rather than be assumed.
    ".astro/types.d.ts"
  ]
}
